{
  "name": "opencode-skills-agents",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm run create_config && npm run mount_configs",
    "create_config": "node ./scripts/index.js",
    "mount_configs": "ln -sfn \"$PWD\"/dist/* ~/.settings/.config/opencode/",

    "exec": "docker exec -it opencode_config_watcher /bin/bash",
    "start": "docker-compose -f docker-compose.yml up -d",
    "stop": "docker-compose -f docker-compose.yml stop && docker ps",

    "watch": "node ./scripts/watch.js"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.15.0",
    "chokidar": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "strip-json-comments": "^5.0.3"
  }
}
