{
  "$schema": "https://opencode.ai/config.json11",
  "username": "Serhii",
  "autoupdate": true,
  "agent": {
    "example": {
      "disable": true
    },
    "build": {
      "mode": "primary",
      "temperature": 0.1
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "permission": {
    "bash": {
      "*": "deny",
      "~/projects/**": "ask",
      "~/.config/opencode/**": "ask",
      "echo *": "allow",
      "pwd": "allow",
      "ls *": "allow",
      "git status *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "npm run *": "allow"
    },
    "read": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "write": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow"
    },
    "edit": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow"
    },
    "list": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow"
    },
    "glob": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow"
    },
    "grep": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow"
    },
    "external_directory": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".idea/**"
    ]
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
