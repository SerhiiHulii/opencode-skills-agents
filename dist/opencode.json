      "disabled": false,
      "command": []
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "deny",
      "~/projects/**": "ask",
      "~/.config/opencode/**": "ask",
      "echo *": "allow",
      "pwd": "allow",
      "ls *": "allow",
      "git status *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "npm run *": "allow",
      "grep *": "allow",
      "cat *": "allow"
    },
    "read": {
      "*": "deny",
      "~/projects/**": "allow",
      "~/.config/opencode/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "write": {
